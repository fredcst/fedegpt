FROM docker.artifactory-dogen.group.echonet/php:8.3-fpm-alpine

# 👉 Proxy (forma correcta en Alpine)
ENV http_proxy="http://f01466:MiCuenta2021%21%21@ncproxy.fr.net.intra:8080"
ENV https_proxy="http://f01466:MiCuenta2021%21%21@ncproxy.fr.net.intra:8080"

# 👉 Dependencias del sistema
RUN apk add --no-cache \
    git nano zip unzip \
    libjpeg-turbo-dev \
    libpng-dev \
    libzip-dev \
    icu-dev \
    freetype-dev \
    libpq-dev \
    oniguruma-dev \
    curl \
    ca-certificates

# 👉 Certificados corporativos
COPY docker/certs/corp-ca.crt /usr/local/share/ca-certificates/corp-ca.crt
RUN update-ca-certificates

# 👉 Configurar y compilar extensiones PHP
RUN docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j$(nproc) \
        intl \
        pdo \
        pdo_pgsql \
        pgsql \
        zip \
        opcache \
        gd

# 👉 Composer
RUN curl -fsSL https://getcomposer.org/installer -o composer-setup.php \
    && php composer-setup.php --install-dir=/usr/local/bin --filename=composer \
    && rm composer-setup.php

# 👉 Config PHP
COPY docker/php/conf.d/memory.ini /usr/local/etc/php/conf.d/memory.ini

WORKDIR /var/www



version: "3.9"

services:
  traefik:
    image: traefik:v3.0
    command:
      - --api.insecure=true
      - --providers.docker=true
      - --entrypoints.web.address=:80
    ports:
      - "80:80"
      - "8081:8080"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    networks:
      - web

networks:
  web:
    name: web




version: "3.9"

services:
  nginx:
    image: nginx:alpine
    volumes:
      - ../../projects/calculette:/var/www
      - ../../docker/nginx/default.conf:/etc/nginx/conf.d/default.conf
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.calculette.rule=Host(`calculette.local`)"
      - "traefik.http.services.calculette.loadbalancer.server.port=80"
    depends_on:
      - php
    networks:
      - web

  php:
    build:
      context: ../../
      dockerfile: docker/php/Dockerfile
      args:
        HTTP_PROXY: ${HTTP_PROXY}
        HTTPS_PROXY: ${HTTPS_PROXY}
        NO_PROXY: ${NO_PROXY}
    volumes:
      - ../../projects/calculette:/var/www
    environment:
      HTTP_PROXY: ${HTTP_PROXY}
      HTTPS_PROXY: ${HTTPS_PROXY}
      NO_PROXY: ${NO_PROXY}
    networks:
      - web
      - internal

  postgres:
    image: postgres:15-alpine
    environment:
      POSTGRES_DB: calculette
      POSTGRES_USER: app
      POSTGRES_PASSWORD: app
    volumes:
      - pgdata:/var/lib/postgresql/data
    networks:
      - internal

volumes:
  pgdata:

networks:
  web:
    external: true
  internal:


server {
    listen 80;

    root /var/www/public;
    index index.php index.html;

    location / {
        try_files $uri /index.php?$query_string;
    }

    location ~ \.php$ {
        fastcgi_pass php:9000;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
    }
}













if (!empty($_SERVER['HTTP_X_FORWARDED_HOST'])) {
    $hosts = explode(',', $_SERVER['HTTP_X_FORWARDED_HOST']);
    $_SERVER['HTTP_HOST'] = trim($hosts[0]);
    $_SERVER['SERVER_NAME'] = trim($hosts[0]);
}

if (!empty($_SERVER['HTTP_X_FORWARDED_PROTO'])) {
    $protos = explode(',', $_SERVER['HTTP_X_FORWARDED_PROTO']);
    if (trim($protos[0]) === 'https') {
        $_SERVER['HTTPS'] = 'on';
        $_SERVER['SERVER_PORT'] = 443;
    }
}




if (!empty($_SERVER['HTTP_X_FORWARDED_HOST'])) {
    $_SERVER['HTTP_HOST'] = $_SERVER['HTTP_X_FORWARDED_HOST'];
}

if (!empty($_SERVER['HTTP_X_FORWARDED_PROTO']) && $_SERVER['HTTP_X_FORWARDED_PROTO'] == 'https') {
    $_SERVER['HTTPS'] = 'on';
}


