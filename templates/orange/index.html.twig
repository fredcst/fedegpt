{% extends 'base.html.twig' %}

{% block title %}Orange index{% endblock %}

{% block body %}
    <h1>Orange index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Type</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for orange in oranges %}
            <tr>
                <td>{{ orange.id }}</td>
                <td>{{ orange.type }}</td>
                <td>
                    <a href="{{ path('app_orange_show', {'id': orange.id}) }}">show</a>
                    <a href="{{ path('app_orange_edit', {'id': orange.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_orange_new') }}">Create new</a>
{% endblock %}
